# ---- server
PORT=8787
# memory | file   (file persists to DGI_DATA_DIR/store.json; Azure SQL adapter is the next step, see docs)
DGI_STORE=file
DGI_DATA_DIR=./data
# dev | entra
DGI_AUTH=dev

# ---- Entra ID (DGI_AUTH=entra)
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=api://dgi-studios
# Map Entra app roles / groups to tenant memberships in config/access.json (users[].id = Entra oid or UPN)

# ---- publishing sinks. A sink with no credentials runs in dry-run mode and writes to DGI_OUTBOX_DIR.
DGI_OUTBOX_DIR=./outbox
# Domo (client credentials app with the "data" scope)
DOMO_CLIENT_ID=
DOMO_CLIENT_SECRET=
DOMO_API_HOST=https://api.domo.com
# JSON map of flattened table name -> Domo dataset id, e.g. {"policy__objectives":"a1b2..."}
DOMO_DATASETS={}
# Azure Service Bus topic that Azure business services subscribe to
AZURE_SERVICEBUS_CONNECTION_STRING=
AZURE_SERVICEBUS_TOPIC=studio-published
# Compass workspace export (a checked-out repo or mounted share)
COMPASS_EXPORT_DIR=./outbox/compass

# ---- service principals (dev keys are in config/access.json)
DGI_SVC_AZURE_AI_KEY=
